# =====================================================================
# 통합 배포 환경변수 템플릿
#   1) 이 파일을 .env.production 으로 복사
#   2) CHANGE_ME / example 값을 실제 값으로 교체
#   3) .env.production 은 절대 git 에 커밋하지 말 것 (.gitignore 에 포함됨)
# =====================================================================

# -------- 도메인 (한 개만 필요) --------
# 관리자 웹=도메인 루트, API=/api, 업로드=/uploads 로 모두 이 도메인에서 서비스.
# 사전 준비: 이 도메인의 A 레코드가 서버 공인 IP를 가리켜야 Caddy 가 HTTPS 발급.
DOMAIN=yosan.example.com
# Let's Encrypt 만료 알림 이메일
ACME_EMAIL=admin@example.com

# =========================================================================
#  외부 노출 방식 — 아래 [A] 또는 [B] 중 "하나만" 선택해서 그대로 따라 하세요.
# =========================================================================
#
#  [A] 도메인 + 공인 IP 가 있는 경우   ← 기본 / 권장
#      · 맨 아래 두 줄(SITE_ADDRESS, CLOUDFLARE_TUNNEL_TOKEN)을 "빈 값 그대로" 둔다.
#      · Caddy 가 위 DOMAIN 으로 HTTPS 를 자동 발급한다.
#      · 실행:
#          docker compose -f docker-compose.prod.yml --env-file .env.production up -d --build
#
#  [B] 공인 IP 가 없거나 NAT/방화벽 뒤인 경우 (Cloudflare 고정 터널)
#      1) Cloudflare Zero Trust → Networks → Tunnels → 터널 생성 → "토큰" 복사
#      2) 그 터널의 Public hostname 을  서비스: http://caddy:80  으로 지정
#      3) 맨 아래 두 줄을 "정확히" 아래처럼 채운다:
#             SITE_ADDRESS=:80
#             CLOUDFLARE_TUNNEL_TOKEN=<1번에서 복사한 토큰>
#      · 실행 (--profile tunnel 추가):
#          docker compose -f docker-compose.prod.yml --env-file .env.production --profile tunnel up -d --build
#
#  ▼ [A] → 둘 다 비움 / [B] → SITE_ADDRESS=:80 과 토큰을 채움
SITE_ADDRESS=
CLOUDFLARE_TUNNEL_TOKEN=

# -------- 데이터베이스 --------
DB_USER=yosan
# 32자+ 무작위 (생성 예: openssl rand -base64 36)
DB_PASSWORD=CHANGE_ME_strong_random_db_password
DB_NAME=yosan

# -------- 보안 --------
# JWT 서명 키. 노출되면 토큰 위조 가능. 64자+ 무작위 (생성 예: openssl rand -base64 64)
SECRET_KEY=CHANGE_ME_very_long_random_secret_key
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# -------- CORS --------
# 관리자 웹이 같은 도메인(동일 출처)이라 보통 비워둔다.
# 다른 출처의 관리 도구를 붙일 때만 https 도메인을 콤마로 추가.
CORS_ORIGINS=

# -------- 시드 관리자 (최초 부팅 시 1회 생성) --------
# 로그인 후 즉시 비밀번호를 변경하거나 새 관리자 생성 후 이 계정 폐기 권장.
SEED_ADMIN_EMAIL=admin@yosan.com
SEED_ADMIN_PASSWORD=CHANGE_ME_initial_admin_password

# -------- 성능 --------
# uvicorn 워커 수. 작은 서버 2~4 권장.
UVICORN_WORKERS=4

# -------- 모바일 빌더(선택) --------
# 이식된 환경에서 모바일 앱을 계속 빌드/OTA 하려면 Expo 액세스 토큰을 넣는다.
# (expo.dev → Account → Access tokens). 서버 운영에는 불필요.
# 사용: docker compose --profile mobile run --rm mobile-builder eas update ...
EXPO_TOKEN=
