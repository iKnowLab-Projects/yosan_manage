# =====================================================================
# 통합 배포 환경변수 템플릿
#   1) 이 파일을 .env.production 으로 복사
#   2) CHANGE_ME / example 값을 실제 값으로 교체
#   3) .env.production 은 절대 git 에 커밋하지 말 것 (.gitignore 에 포함됨)
# =====================================================================

# -------- 도메인 (한 개만 필요) --------
# 관리자 웹=도메인 루트, API=/api, 업로드=/uploads 로 모두 이 도메인에서 서비스.
# 사전 준비: 이 도메인의 A 레코드가 서버 공인 IP를 가리켜야 Caddy 가 HTTPS 발급.
DOMAIN=yosan.example.com
# Let's Encrypt 만료 알림 이메일
ACME_EMAIL=admin@example.com

# -------- 데이터베이스 --------
DB_USER=yosan
# 32자+ 무작위 (생성 예: openssl rand -base64 36)
DB_PASSWORD=CHANGE_ME_strong_random_db_password
DB_NAME=yosan

# -------- 보안 --------
# JWT 서명 키. 노출되면 토큰 위조 가능. 64자+ 무작위 (생성 예: openssl rand -base64 64)
SECRET_KEY=CHANGE_ME_very_long_random_secret_key
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# -------- CORS --------
# 관리자 웹이 같은 도메인(동일 출처)이라 보통 비워둔다.
# 다른 출처의 관리 도구를 붙일 때만 https 도메인을 콤마로 추가.
CORS_ORIGINS=

# -------- 시드 관리자 (최초 부팅 시 1회 생성) --------
# 로그인 후 즉시 비밀번호를 변경하거나 새 관리자 생성 후 이 계정 폐기 권장.
SEED_ADMIN_EMAIL=admin@yosan.com
SEED_ADMIN_PASSWORD=CHANGE_ME_initial_admin_password

# -------- 성능 --------
# uvicorn 워커 수. 작은 서버 2~4 권장.
UVICORN_WORKERS=4
