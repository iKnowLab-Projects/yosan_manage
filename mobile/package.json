{
  "name": "yosan-mobile",
  "version": "0.1.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "deploy:android": "cross-env APP_TARGET=android eas update --branch preview --platform android",
    "deploy:ios": "cross-env APP_TARGET=ios eas update --branch production --platform ios",
    "deploy:both": "npm run deploy:android && npm run deploy:ios",
    "updates:android": "cross-env APP_TARGET=android eas update:list --branch preview --limit 5",
    "updates:ios": "cross-env APP_TARGET=ios eas update:list --branch production --limit 5",
    "build:ios": "cross-env APP_TARGET=ios eas build --platform ios --profile production-ios",
    "submit:ios": "cross-env APP_TARGET=ios eas submit --platform ios --latest"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^2.2.0",
    "babel-preset-expo": "~54.0.10",
    "expo": "^54.0.0",
    "expo-constants": "~18.0.13",
    "expo-device": "~8.0.10",
    "expo-linking": "~8.0.12",
    "expo-notifications": "^0.32.17",
    "expo-router": "~6.0.23",
    "expo-secure-store": "~15.0.8",
    "expo-status-bar": "~3.0.9",
    "expo-updates": "~29.0.18",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-native": "^0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@types/react": "~19.1.10",
    "cross-env": "^10.1.0",
    "typescript": "~5.9.2"
  },
  "private": true
}
