{
  "cli": {
    "version": ">= 7.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": { "buildType": "apk" },
      "ios": { "simulator": true }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "env": { "APP_TARGET": "android" },
      "android": { "buildType": "apk" },
      "ios": {
        "simulator": false
      }
    },
    "production": {
      "channel": "production",
      "autoIncrement": true,
      "env": { "APP_TARGET": "android" },
      "android": { "buildType": "app-bundle" },
      "ios": {}
    },
    "production-ios": {
      "channel": "production",
      "autoIncrement": true,
      "env": { "APP_TARGET": "ios" },
      "ios": {}
    }
  },
  "submit": {
    "production": {}
  }
}
