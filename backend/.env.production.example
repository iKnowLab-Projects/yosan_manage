# =======================================================
# 운영(production) 환경 변수 템플릿
# 1. 이 파일을 .env.production 으로 복사
# 2. 모든 CHANGE_ME 항목을 실 값으로 교체
# 3. .env.production 은 절대 git 에 커밋하지 말 것 (이미 .gitignore에 추가됨)
# =======================================================

# -------- 도메인 --------
# 백엔드 API 도메인. Caddy 가 자동으로 Let's Encrypt 인증서를 발급.
# 사전 준비: A 레코드가 이 서버의 공인 IP를 가리키도록 DNS 설정 필요.
DOMAIN_API=api.example.com

# Let's Encrypt 갱신 알림 이메일 (만료 임박 시 통보)
ACME_EMAIL=admin@example.com

# -------- 데이터베이스 --------
DB_USER=yosan
# 32자 이상 무작위. 생성 명령: python -c "import secrets; print(secrets.token_urlsafe(48))"
DB_PASSWORD=CHANGE_ME_strong_random_db_password
DB_NAME=yosan

# -------- 보안 --------
# JWT 서명 키. 노출되면 모든 토큰을 위조 가능. 64자 이상 무작위.
# 생성: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=CHANGE_ME_very_long_random_secret_key
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# -------- CORS --------
# 관리자 웹 도메인 (콤마 구분). 모바일 native fetch 는 CORS 무관.
CORS_ORIGINS=https://admin.example.com

# -------- 시드 관리자 --------
# 최초 부팅 시 1회 자동 생성. 로그인 후 즉시 비밀번호 변경하거나 별도 관리자 생성 후 폐기 권장.
SEED_ADMIN_EMAIL=admin@yosan.com
SEED_ADMIN_PASSWORD=CHANGE_ME_initial_admin_password

# -------- Firebase / 푸시 --------
# 서비스 계정 JSON 파일을 호스트의 ./creds/ 폴더에 저장하고, 컨테이너 안 경로를 지정.
# 예) 호스트: ./creds/firebase-adminsdk.json
#     컨테이너: /app/creds/firebase-adminsdk.json
# 푸시는 실질적으로 Expo Push Service 가 처리하므로 백엔드에서는 사용하지 않을 수도 있음 (현재 push.py 는 Expo Push HTTP 만 사용).
# Expo Push 만 쓸 경우 비워둬도 무방.
FIREBASE_CREDENTIALS_PATH=
FIREBASE_CREDENTIALS_HOST_DIR=./creds

# -------- 성능 --------
# uvicorn 워커 수. CPU 코어 수와 비슷하게 설정. 작은 서버는 2~4 권장.
UVICORN_WORKERS=4
